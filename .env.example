# Variáveis da Api.Agente fora da máquina local. Modelo sem segredos: configure os valores no provedor.

# Obrigatórias
# Neon: use o host direto, sem "-pooler". O bloqueio dos agendadores e as migrações precisam de sessão.
ConnectionStrings__Postgres=Host=SEU_HOST_DIRETO.neon.tech;Port=5432;Database=SEU_BANCO;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require
# Atlas: escape caracteres especiais da senha. O nome do banco vem de Memoria:BancoMongo.
ConnectionStrings__Mongo=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/
Llm__ApiKey=SUA_CHAVE_OPENAI
# Identifica quem aprovou a carga inicial do catálogo em produção.
Coleta__AprovadorCatalogoInicial=NOME_DO_APROVADOR
# Na Vercel, a coleta e a retenção rodam pelas rotas de tarefas, não pelos agendadores internos.
Agendamento__Habilitado=false
# Gere um valor aleatório longo e use o mesmo no segredo AGENTE_TOKEN_GATILHO do GitHub.
Agendamento__TokenGatilho=SEU_TOKEN_ALEATORIO
# Chave Bearer compartilhada com a SOFIA (Agent Card e /a2a). Sem ela, a integração A2A responde 503.
SOFIA_A2A_TOKEN=CHAVE_FORNECIDA_PELA_SOFIA

# Opcionais
# Origens do frontend da SOFIA no navegador (CORS). O appsettings.json já traz a origem de produção;
# defina aqui só para trocar a lista. Esquema + host + porta, sem barra final. Não autentica ninguém.
# Cors__AllowedOrigins__0=https://sofia-infis.onrender.com
# URL pública do endpoint A2A anunciada no Agent Card (/.well-known/agent-card.json).
# A2A__UrlPublica=https://SEU_AGENTE.vercel.app/a2a
# Swagger em /swagger e OpenAPI em /openapi/v1.json. O Dockerfile.vercel já liga; use false para desligar.
# Swagger__Habilitado=false
# Na Vercel, a porta padrão é 80. Defina somente para usar outra.
# PORT=8080
# OpenTelemetry__Endpoint=https://SEU_COLETOR_OTLP
