{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope-resposta/v1",
  "title": "Envelope de resposta da Api.Agente (v1)",
  "description": "Preenchido pelo sistema. O campo 'resultado' contém apenas dados validados; nenhum campo deste envelope é produzido pelo LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versaoContrato", "execucaoId", "correlacaoId", "status", "iniciadoEm", "finalizadoEm", "requerRevisaoHumana", "achados", "limitacoes", "consumo"],
  "properties": {
    "versaoContrato": { "const": "1.2" },
    "execucaoId": { "type": "string", "format": "uuid" },
    "correlacaoId": { "type": "string" },
    "status": {
      "enum": ["concluido", "concluido_com_limitacoes", "falha_tecnica", "rejeitado_validacao"],
      "description": "concluido_com_limitacoes quando alguma fonte ou etapa falhou; nunca indica conformidade."
    },
    "iniciadoEm": { "type": "string", "format": "date-time" },
    "finalizadoEm": { "type": "string", "format": "date-time" },
    "requerRevisaoHumana": { "type": "boolean" },
    "resultado": {
      "oneOf": [
        { "$ref": "#/$defs/resultadoConsulta" },
        { "type": "null" }
      ]
    },
    "achados": {
      "type": "array",
      "items": { "$ref": "#/$defs/achado" }
    },
    "limitacoes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Inclui validações e etapas não realizadas."
    },
    "consumo": { "$ref": "#/$defs/consumo" }
  },
  "$defs": {
    "resultadoConsulta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assunto", "periodo", "fontesConsultadas", "fontesComFalha", "novidades", "itensOmitidos", "grupos"],
      "properties": {
        "assunto": { "type": "string" },
        "periodo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inicio", "fim"],
          "properties": { "inicio": { "type": "string", "format": "date" }, "fim": { "type": "string", "format": "date" } }
        },
        "cliente": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nome", "nicho"],
          "properties": { "nome": { "type": "string" }, "nicho": { "$ref": "#/$defs/nicho" } }
        },
        "fontesConsultadas": { "type": "array", "items": { "type": "string" } },
        "fontesComFalha": { "type": "array", "items": { "type": "string" } },
        "novidades": { "type": "array", "items": { "$ref": "#/$defs/novidade" } },
        "itensOmitidos": { "type": "integer", "minimum": 0, "description": "Quantidade cortada pelo limite de itens." },
        "ocultadasNaoTributarias": { "type": "integer", "minimum": 0, "description": "Quantidade ocultada por indício da IA de não ter relação tributária (FR-008b)." },
        "mensagemSemNovidades": { "type": "string", "description": "Presente quando novidades está vazio; nunca afirma ausência de mudança normativa." },
        "grupos": {
          "type": "array",
          "description": "As mesmas novidades agrupadas por perfil, esfera e situação (FR-011). Grupos vazios são omitidos. Uma novidade com dois perfis aparece nos dois; com filtro de perfil, só os perfis pedidos aparecem. Sem perfil informado, vale consultor_tributario.",
          "items": { "$ref": "#/$defs/grupoPerfil" }
        }
      }
    },
    "grupoPerfil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perfil", "total", "esferas"],
      "properties": {
        "perfil": { "enum": ["consultor_tributario", "desenvolvedor"] },
        "total": { "type": "integer", "minimum": 1 },
        "esferas": { "type": "array", "items": { "$ref": "#/$defs/grupoEsfera" } }
      }
    },
    "grupoEsfera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["esfera", "total", "situacoes"],
      "properties": {
        "esfera": { "enum": ["federal", "estadual", "municipal"] },
        "total": { "type": "integer", "minimum": 1 },
        "situacoes": { "type": "array", "items": { "$ref": "#/$defs/grupoSituacao" } }
      }
    },
    "grupoSituacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["situacao", "novidades"],
      "properties": {
        "situacao": { "enum": ["confirmada", "pendente_confirmacao", "fonte_nao_catalogada", "em_analise"] },
        "novidades": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/novidade" } }
      }
    },
    "novidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "situacao", "esfera", "perfis", "origemPerfil", "dataPublicacao", "orgaoEmissor", "tipoAto", "ementa", "evidencias", "requerRevisaoHumana"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "situacao": { "enum": ["confirmada", "pendente_confirmacao", "fonte_nao_catalogada", "em_analise"] },
        "esfera": { "enum": ["federal", "estadual", "municipal"] },
        "ente": { "type": ["string", "null"] },
        "perfis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["consultor_tributario", "desenvolvedor"] } },
        "origemPerfil": { "$ref": "#/$defs/origem" },
        "dataPublicacao": { "type": "string", "format": "date" },
        "orgaoEmissor": { "type": "string" },
        "tipoAto": { "type": "string" },
        "numeroAto": { "type": ["string", "null"] },
        "ementa": { "type": "string" },
        "tema": { "type": ["string", "null"] },
        "impacto": { "enum": ["alto", "medio", "baixo", null] },
        "origemImpacto": { "oneOf": [{ "$ref": "#/$defs/origem" }, { "type": "null" }] },
        "relacaoNicho": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["justificativa", "origem"],
          "properties": { "justificativa": { "type": "string" }, "origem": { "$ref": "#/$defs/origem" } }
        },
        "retificaNovidadeId": { "type": ["string", "null"], "format": "uuid" },
        "evidencias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fonteCodigo", "url", "principal"],
            "properties": {
              "fonteCodigo": { "type": ["string", "null"], "description": "null para fonte fora do catálogo" },
              "url": { "type": "string", "format": "uri" },
              "principal": { "type": "boolean" }
            }
          }
        },
        "requerRevisaoHumana": { "type": "boolean" },
        "relacionadaTributos": { "type": ["boolean", "null"], "description": "Indício da IA; null enquanto não classificada. false só aparece com incluirNaoTributarias." }
      }
    },
    "achado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoria", "descricao"],
      "properties": {
        "categoria": {
          "enum": ["erro_estrutural", "inconsistencia_negocio", "indicio_ia", "ausencia_evidencia", "falha_tecnica"],
          "description": "Cinco categorias do Princípio IV."
        },
        "severidade": { "type": "null", "description": "Escala pendente (DP-07); sempre null na v1." },
        "descricao": { "type": "string" },
        "referencia": { "type": ["string", "null"], "description": "Código da fonte ou id da novidade relacionada." }
      }
    },
    "consumo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chamadasLlm", "tokensEntrada", "tokensSaida", "usoConhecido", "custoEstimado", "moeda"],
      "properties": {
        "chamadasLlm": { "type": "integer", "minimum": 0 },
        "tokensEntrada": { "type": ["integer", "null"] },
        "tokensSaida": { "type": ["integer", "null"] },
        "usoConhecido": { "type": "boolean", "description": "false quando alguma chamada não informou uso; totais então são parciais ou null." },
        "custoEstimado": { "type": ["number", "null"] },
        "moeda": { "type": ["string", "null"] }
      }
    },
    "origem": { "enum": ["regra_deterministica", "indicio_ia"] },
    "nicho": { "enum": ["varejo_mercadorias", "produtos_farmaceuticos", "tributacao_padrao"] }
  }
}
