{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infis.local/sofia/contrato/1.0/solicitacao-analise-sofia.schema.json",
  "title": "SolicitacaoAnaliseSofia v1.0",
  "description": "Pedido da SOFIA a um agente especializado. Transportado como JSON em TextPart de uma Message A2A v0.3. Campos desconhecidos são tolerados (evolução compatível da v1); limites de tamanho são validados pelo agente.",
  "type": "object",
  "required": ["versaoContrato", "idExecucao", "idSolicitacao", "usuario", "pergunta", "documentos"],
  "properties": {
    "versaoContrato": { "const": "1.0" },
    "idExecucao": { "$ref": "#/$defs/uuid" },
    "idSolicitacao": { "$ref": "#/$defs/uuid" },
    "usuario": {
      "type": "object",
      "required": ["nome"],
      "properties": { "nome": { "$ref": "#/$defs/textoObrigatorio" } }
    },
    "pergunta": { "$ref": "#/$defs/textoObrigatorio" },
    "documentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["idDocumento", "nome", "texto"],
        "properties": {
          "idDocumento": { "$ref": "#/$defs/textoObrigatorio" },
          "nome": { "$ref": "#/$defs/textoObrigatorio" },
          "tipo": { "type": ["string", "null"] },
          "texto": { "$ref": "#/$defs/textoObrigatorio" }
        }
      }
    },
    "contexto": {
      "type": ["object", "null"],
      "properties": {
        "idioma": { "type": ["string", "null"] },
        "instrucoes": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "textoObrigatorio": { "type": "string", "pattern": "\\S" }
  }
}
