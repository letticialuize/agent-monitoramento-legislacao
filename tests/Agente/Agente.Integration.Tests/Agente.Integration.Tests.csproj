    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Agente\Agente.Domain\Agente.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Agente\Agente.Application\Agente.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Agente\Agente.Infrastructure\Agente.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Agente\Api.Agente\Api.Agente.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\specs\001-monitoramento-boletim-diario\contracts\*.*" LinkBase="Contratos" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
