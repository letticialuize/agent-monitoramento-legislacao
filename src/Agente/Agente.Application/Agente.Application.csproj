<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Agente.Domain\Agente.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validação de contratos JSON da saída do LLM (exceção registrada no ADR 0006). -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\specs\001-monitoramento-boletim-diario\contracts\llm-*.schema.json" LinkBase="Llm\Contratos" LogicalName="Contratos.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agente.Application.Tests" />
  </ItemGroup>

  <!-- Sem os contratos o build passaria e a coleta quebraria só em produção (ex.: .dockerignore excluindo specs/). -->
  <Target Name="ExigirContratosLlm" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\..\..\specs\001-monitoramento-boletim-diario\contracts\llm-classificacao-novidade.schema.json') Or !Exists('..\..\..\specs\001-monitoramento-boletim-diario\contracts\llm-relacao-nicho.schema.json') Or !Exists('..\..\..\specs\001-monitoramento-boletim-diario\contracts\llm-resumo-boletim.schema.json')"
           Text="Contratos LLM ausentes em specs/001-monitoramento-boletim-diario/contracts. Confira o .dockerignore." />
  </Target>

</Project>
