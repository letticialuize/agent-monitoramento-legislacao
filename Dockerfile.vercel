# Imagem da Api.Agente para o Container Runtime da Vercel (beta).
# Contexto de build: raiz do repositório. Nenhum segredo entra na imagem: configure-os no provedor.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore "src/Agente/Api.Agente/Api.Agente.csproj"
RUN dotnet publish "src/Agente/Api.Agente/Api.Agente.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false
# As credenciais locais de desenvolvimento não vão para a imagem.
RUN rm -f /app/publish/appsettings.Development.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
ENV APP_DLL="Api.Agente.dll"
# Swagger ligado na Vercel por decisão da responsável (ADR 0007). Para desligar sem rebuild, defina
# Swagger__Habilitado=false nas variáveis do projeto na Vercel, que têm prioridade sobre este valor.
ENV Swagger__Habilitado=true
# A Vercel termina o HTTPS e repassa em HTTP com X-Forwarded-Proto/For. Sem isto, a API acha que está
# em http: o Swagger chamaria http:// (bloqueado pelo navegador) e o Agent Card sem A2A__UrlPublica sairia http.
# O container só recebe tráfego pela Vercel, então os cabeçalhos dela são confiáveis.
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# A rota de coleta tem 300 s na Vercel. Com 60 s e 2 retentativas, uma fonte fora do ar (ex.: CONFAZ)
# consumia 3 min e a classificação pela IA era cortada (504). As fontes que respondem levam menos de 2 s.
ENV Coleta__TimeoutPadraoSegundos=20
ENV Coleta__TentativasPorFonte=1
# A Vercel envia o tráfego para a porta 80, salvo se PORT estiver definida no projeto.
CMD ["sh", "-c", "export ASPNETCORE_URLS=\"http://0.0.0.0:${PORT:-80}\"; exec dotnet \"$APP_DLL\""]
